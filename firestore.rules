rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Posts: Public read access, but only owners can create/update/delete
    match /posts/{postId} {
      allow read: if true; // Public read access for all users (logged in or not)
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Appointments: Allow guest booking; authenticated users can still book and manage their own
    match /appointments/{appointmentId} {
      // Authenticated users can read their own; guests cannot read (no auth)
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;

      // Create allowed for both guests and signed-in users. If signed in, userId must match auth uid; guests may omit userId.
      allow create: if (!isSignedIn()) || (request.resource.data.userId == request.auth.uid);

      // Updates/deletes remain restricted to the owner
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Listings: Users can only read/write their own listings
    match /listings/{listingId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
